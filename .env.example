# Copie este arquivo para .env e preencha os valores. O arquivo .env NUNCA deve ser versionado.

# ---------- Frontend (variáveis VITE_ são públicas: vão para o navegador) ----------
# WhatsApp da loja: DDI + DDD + número, apenas dígitos (ex.: 55 61 9XXXX-XXXX -> 55619XXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Endpoint do backend de IA. Em desenvolvimento, deixe vazio (usa /api/ai via proxy do Vite).
# Com Supabase: https://<projeto>.supabase.co/functions/v1/ai-assistant
# Com Cloudflare Workers: https://<worker>.<conta>.workers.dev/api/ai
VITE_AI_ENDPOINT=

# Supabase (opcional). A chave "anon" é pública por natureza; a proteção vem das políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Backend de IA (npm run server) — SEGREDOS, nunca use o prefixo VITE_ ----------
# Orçamento R$ 0,00: use SOMENTE o plano gratuito do Google Gemini.
# Crie a chave em https://aistudio.google.com em um projeto SEM faturamento (não vincule cartão/billing).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Opcional (padrão: gemini-3.5-flash-lite). Apenas modelos gratuitos da lista em providers/gemini.ts são aceitos.
AI_MODEL=
# Opcional: máximo de consultas por dia (padrão 40; 0 desativa o assistente)
AI_DAILY_LIMIT=
# Opcional: formato da saída estruturada (responseFormat | responseJsonSchema)
GEMINI_STRUCTURED_OUTPUT=
AI_SERVER_PORT=8787
